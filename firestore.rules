rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email == 'arikarran14@gmail.com') ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Top level Organizations collection
    match /Organizations/{orgId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && (
        isAdmin() ||
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['premium_status', 'premium_start_date', 'premium_expiry_date', 'subscriptionTier']))
      );
      allow delete: if isAdmin();
      
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Top level Users collection
    match /Users/{userId} {
      allow read, write: if request.auth != null;
      allow create: if true; // Permit account registration
    }

    // Top level OTP Verifications collection (accessible to non-authenticated users registering)
    match /OTP_Verifications/{email} {
      allow read, write: if true;
    }

    // Top level Bank Accounts collection (accessible to authenticated users)
    match /BankAccounts/{accountId} {
      allow read, write: if request.auth != null;
    }

    // Top level PremiumHistory collection
    match /PremiumHistory/{historyId} {
      allow read, write: if isAdmin();
    }

    // Top level Payments collection
    match /Payments/{paymentId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        resource.data.userEmail == request.auth.token.email
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        request.resource.data.userEmail == request.auth.token.email
      );
      allow update, delete: if isAdmin();
    }
    
    // Explicit deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
