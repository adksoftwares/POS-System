rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'arikarran14@gmail.com' ||
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Top level Organizations collection
    match /Organizations/{orgId} {
      allow read, write: if request.auth != null;
      
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Top level Users collection
    match /Users/{userId} {
      allow read, write: if request.auth != null;
      allow create: if true; // Permit account registration
    }

    // Top level OTP Verifications collection (accessible to non-authenticated users registering)
    match /OTP_Verifications/{email} {
      allow read, write: if true;
    }

    // Top level Bank Accounts collection (accessible to authenticated users)
    match /BankAccounts/{accountId} {
      allow read, write: if request.auth != null;
    }

    // Top level LicenseKeys collection
    match /LicenseKeys/{keyId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        resource.data.email == request.auth.token.email
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        request.resource.data.email == request.auth.token.email
      );
      allow update: if request.auth != null && (
        isAdmin() || 
        resource.data.email == request.auth.token.email
      );
      allow delete: if isAdmin();
    }

    // Top level Payments collection
    match /Payments/{paymentId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        resource.data.userEmail == request.auth.token.email
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        request.resource.data.userEmail == request.auth.token.email
      );
      allow update, delete: if isAdmin();
    }
    
    // Explicit deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
